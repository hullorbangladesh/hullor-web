{
  "version": 2,
  "builds": [
    { "src": "**/*.html", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/products", "dest": "/products.html" },
    { "src": "/product-detail", "dest": "/product-detail.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}