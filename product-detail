<script src="assets/js/products-data.js"></script>
<script>
  /* ── Nav ─────────────────────────────────────────────── */
  const hamburger = document.getElementById("hamburger");
  const mobileMenu = document.getElementById("mobileMenu");
  hamburger.addEventListener("click", () => {
    hamburger.classList.toggle("open");
    mobileMenu.classList.toggle("open");
  });

  /* ── Load product from URL ───────────────────────────── */
  const params  = new URLSearchParams(location.search);
  const pid     = params.get("id");
  const product = PRODUCTS.find(p => p.id === pid);

  if (!product) {
    document.querySelector(".product-page").innerHTML = `
      <div style="grid-column:1/-1;text-align:center;padding:80px 20px;">
        <p style="font-size:52px;margin-bottom:20px;">🔍</p>
        <h2 style="font-family:'Playfair Display',serif;color:var(--forest-deep);margin-bottom:12px;">Product not found</h2>
        <a href="products.html" style="color:var(--gold)">← Back to store</a>
      </div>`;
  } else {
    /* Page meta */
    document.title = product.name + " — Hullor Bangladesh";
    document.getElementById("breadcrumbName").textContent = product.name;
    document.getElementById("infoBadge").textContent      = product.badge;
    document.getElementById("infoName").textContent       = product.name;
    document.getElementById("infoPrice").innerHTML        = `<sup>৳</sup>${product.price.toLocaleString("en-BD")}`;
    document.getElementById("infoDesc").textContent       = product.longDesc;
    document.getElementById("infoSpecs").innerHTML        = product.specs.map(s => `<span class="spec-chip">${s}</span>`).join("");

    /* ── Gallery ─────────────────────────────────────── */
    let activeImg = 0;
    const mainImg = document.getElementById("mainImg");
    mainImg.src = product.images[0];
    mainImg.alt = product.name;

    document.getElementById("thumbs").innerHTML = product.images.map((src, i) => `
      <div class="gallery-thumb${i === 0 ? ' active' : ''}" onclick="switchImg(${i})">
        <img src="${src}" alt="${product.name} view ${i + 1}" onerror="this.src='assets/images/placeholder.png'">
      </div>`).join("");

    function switchImg(i) {
      if (i === activeImg) return;
      activeImg = i;
      mainImg.classList.add("switching");
      setTimeout(() => {
        mainImg.src = product.images[i];
        mainImg.classList.remove("switching");
      }, 200);
      document.querySelectorAll(".gallery-thumb").forEach((t, ti) => t.classList.toggle("active", ti === i));
    }
    window.switchImg = switchImg;

    /* ── Colours ─────────────────────────────────────── */
    let selectedColor = null;
    const enabledColors  = product.colors ? product.colors.filter(c => c.enabled) : [];
    const swatchesEl     = document.getElementById("colorSwatches");
    const colorSection   = document.getElementById("colorSection");

    if (!product.colors || product.colors.length === 0) {
      colorSection.style.display = "none";
    } else {
      swatchesEl.innerHTML = product.colors.map((c, i) => `
        <button class="color-swatch${!c.enabled ? ' disabled' : ''}"
          style="background:${c.hex};${(c.hex === '#F5F1E8' || c.hex === '#EEEEEE') ? 'border:2.5px solid var(--sand);' : ''}"
          title="${c.name}${!c.enabled ? ' (unavailable)' : ''}"
          onclick="selectColor(${i})"
          ${!c.enabled ? 'disabled' : ''}>
        </button>`).join("");

      if (enabledColors.length > 0) {
        const firstIdx = product.colors.findIndex(c => c.enabled);
        selectColor(firstIdx);
      }
    }

    function selectColor(i) {
      const c = product.colors[i];
      if (!c || !c.enabled) return;
      selectedColor = c;
      document.getElementById("colorSelectedName").textContent = "— " + c.name;
      document.querySelectorAll(".color-swatch").forEach((s, si) => s.classList.toggle("active", si === i));
    }
    window.selectColor = selectColor;

    /* ── Delivery options ────────────────────────────── */
    const sel = document.getElementById("delivery");
    DELIVERY_OPTIONS.forEach(d => {
      const opt = document.createElement("option");
      opt.value       = d.charge;
      opt.textContent = `${d.label} (+৳${d.charge})`;
      sel.appendChild(opt);
    });

    /* ── Order panel helpers ─────────────────────────── */
    function openOrder() {
      ["fname", "phone", "address"].forEach(clearField);
      document.getElementById("note").value = "";
      hideError();
      document.getElementById("delivery").selectedIndex = 0;
      updateTotal();
      document.getElementById("panelImg").src           = product.images[0];
      document.getElementById("panelName").textContent  = product.name;
      document.getElementById("panelColor").textContent = selectedColor ? selectedColor.name : "";
      document.getElementById("panelPrice").textContent = "৳" + product.price.toLocaleString("en-BD");
      document.getElementById("orderOverlay").classList.add("open");
    }
    function closeOrder() { document.getElementById("orderOverlay").classList.remove("open"); }
    window.openOrder  = openOrder;
    window.closeOrder = closeOrder;

    function updateTotal() {
      const charge = parseInt(document.getElementById("delivery").value) || 0;
      const total  = product.price + charge;
      document.getElementById("totalSub").textContent   = `৳${product.price} + ৳${charge} delivery`;
      document.getElementById("totalPrice").textContent = "৳" + total.toLocaleString("en-BD");
    }
    window.updateTotal = updateTotal;

    /* ── Validation helpers ──────────────────────────── */
    function clearField(id) {
      const el = document.getElementById(id);
      if (el) { el.value = ""; el.classList.remove("error"); }
      const err = document.getElementById(id + "Err");
      if (err) err.classList.remove("show");
    }
    function hideError() { document.getElementById("errorBanner").classList.remove("show"); }
    function showError(msgs) {
      const banner = document.getElementById("errorBanner");
      const text   = document.getElementById("errorText");
      text.innerHTML = `<strong>Please fill in the required fields:</strong><br>${msgs.join(", ")}`;
      banner.classList.add("show");
      banner.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
    function setFieldError(id, show) {
      document.getElementById(id).classList.toggle("error", show);
      document.getElementById(id + "Err").classList.toggle("show", show);
    }

    /* ── Submit ──────────────────────────────────────── */
    async function submitOrder() {
      const fname   = document.getElementById("fname").value.trim();
      const phone   = document.getElementById("phone").value.trim();
      const address = document.getElementById("address").value.trim();
      const note    = document.getElementById("note").value.trim();
      const selEl   = document.getElementById("delivery");
      const charge  = parseInt(selEl.value);
      const area    = DELIVERY_OPTIONS.find(d => d.charge === charge)?.label || selEl.options[selEl.selectedIndex]?.text;
      const total   = product.price + charge;

      const missing = [];
      setFieldError("fname",   !fname);   if (!fname)   missing.push("Full Name");
      setFieldError("phone",   !phone);   if (!phone)   missing.push("Phone Number");
      setFieldError("address", !address); if (!address) missing.push("Address");

      if (missing.length) { showError(missing); return; }
      hideError();

      const btn = document.getElementById("confirmBtn");
      btn.classList.add("loading"); btn.disabled = true;

      const payload = {
        Timestamp: new Date().toLocaleString("en-BD", { timeZone: "Asia/Dhaka" }),
        Product:  product.name,
        Price:    product.price,
        Color:    selectedColor ? selectedColor.name : "N/A",
        Name:     fname,
        Phone:    phone,
        Address:  address,
        Area:     area,
        Delivery: charge,
        Total:    total,
        Note:     note || "—"
      };

      try {
        await fetch(SHEET_URL, {
          method: "POST", mode: "no-cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
      } catch (_) {}

      btn.classList.remove("loading"); btn.disabled = false;
      closeOrder();
      showThankyou({ name: fname, phone, product: product.name, color: selectedColor?.name, price: product.price, area, charge, total, note });
    }
    window.submitOrder = submitOrder;

    /* ── Thank You ───────────────────────────────────── */
    function showThankyou({ name, phone, product: pname, color, price, area, charge, total, note }) {
      document.getElementById("tyName").textContent  = name.split(" ")[0];
      document.getElementById("tyPhone").textContent = phone;
      const rows = [
        ["Product", pname],
        color && ["Colour", color],
        ["Price",    "৳" + price.toLocaleString("en-BD")],
        ["Delivery", `${area} (৳${charge})`],
        note && ["Note", note]
      ].filter(Boolean);
      document.getElementById("tySummary").innerHTML =
        rows.map(([k, v]) => `<div class="ty-row"><span class="ty-key">${k}</span><span class="ty-val">${v}</span></div>`).join("") +
        `<div class="ty-sep"></div><div class="ty-row ty-total"><span class="ty-key">Total</span><span class="ty-val">৳${total.toLocaleString("en-BD")}</span></div>`;
      document.getElementById("thankyouOverlay").classList.add("open");
    }

    function closeThankyou() {
      document.getElementById("thankyouOverlay").classList.remove("open");
      location.href = "products.html";
    }
    window.closeThankyou = closeThankyou;
  }

  /* ── Backdrop & Escape key ───────────────────────────── */
  document.getElementById("orderOverlay").addEventListener("click", function(e) { if (e.target === this) closeOrder(); });
  document.getElementById("thankyouOverlay").addEventListener("click", function(e) { if (e.target === this) closeThankyou(); });
  document.addEventListener("keydown", e => { if (e.key === "Escape") { closeOrder(); closeThankyou(); } });
</script>
</body>
